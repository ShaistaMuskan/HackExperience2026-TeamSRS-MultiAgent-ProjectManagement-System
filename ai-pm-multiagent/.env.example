# ============================================================================
# AI PM Multi-Agent System - environment configuration
# Copy to .env and fill in real values only when USE_MOCK_INTEGRATIONS=false.
# See docs/architecture/azure-foundry-m365-integration-guide.md for how to
# obtain every one of these.
# ============================================================================

APP_NAME="AI PM Multi-Agent System"
ENVIRONMENT=local

# The master flag - keep `true` for local/demo/hackathon use.
USE_MOCK_INTEGRATIONS=true

# Per-service overrides: uncomment to pin ONE integration real/mock without
# flipping the master flag above. Useful for going real one piece at a time -
# e.g. wire up just the LLM while Planner/Teams/SharePoint/Search stay mocked
# until you've implemented/provisioned those too.
# USE_MOCK_PLANNER=true
# USE_MOCK_TEAMS=true
# USE_MOCK_OUTLOOK=true
# USE_MOCK_SHAREPOINT=true
# USE_MOCK_SEARCH=true
# USE_MOCK_LLM=false
# USE_MOCK_BLOB=true
# USE_MOCK_SECRETS=true

# --- Microsoft Entra ID / Graph (Section 2) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
M365_GROUP_ID=
M365_TEAM_ID=

# --- Azure AI Foundry / Azure OpenAI (Section 3) ---
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# --- Azure AI Search (Section 4) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=pm-knowledge-base

# --- Azure Storage (Section 1) ---
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_BRIEFS=project-briefs

# --- Azure Key Vault (Section 5) ---
KEY_VAULT_URL=

# --- App / DB ---
DATABASE_URL=sqlite+aiosqlite:///./ai_pm.db
SECRET_KEY=change-me-in-production
SENTINEL_POLL_INTERVAL_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
